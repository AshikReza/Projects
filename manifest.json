{
  "manifest_version": 3,
  "name": "Algo Hint",
  "version": "1.1",
  "description": "Get AI-powered hints for competitive programming problems.",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.leetcode.com/*",
    "https://*.codeforces.com/*",
    "https://*.atcoder.jp/*",
    "https://*.hackerrank.com/*",
    "https://vjudge.net/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Get a Hint"
  },
  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "ui-injector.js", "content-scraper.js", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
